# Copy this file to .env and fill in real values. Never commit the real .env.

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Keep USE_SQLITE=True for Week-1 local setup with zero config.
# Switch to False once your Supabase Postgres project is ready.
USE_SQLITE=True
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-db-password
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432

# --- Redis (Channels + Celery) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- CORS ---
CORS_ALLOW_ALL_ORIGINS=True

# --- File storage (Phase 1, optional) ---
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
